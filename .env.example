# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================================================================
# LISTINO
# Tutto il catalogo si governa da qui: prezzo, numero di preghiere, ritmo di
# sblocco, attivazione. I valori commentati sono i default: togli il commento
# solo per ciò che vuoi cambiare.
#
#   *_CENTS    prezzo in centesimi (290 = 2,90 €)
#   *_CREDITS  quante preghiere include
#   *_CADENCE  instant | daily | monthly  (come si sbloccano i crediti)
#   *_ENABLED  true | false  (nasconde il prodotto dal sito)
#   *_FEATURED true | false  (lo evidenzia nella griglia)
#   *_NAME     nome mostrato
#   *_STRIPE_PRICE  Price ID di Stripe; se assente il prezzo è creato al volo
# ===========================================================================

# --- Una preghiera — 2,90 € (sempre attiva, non disattivabile) -------------
PRODUCT_SINGLE_CENTS=290
# PRODUCT_SINGLE_NAME=Una preghiera
# PRODUCT_SINGLE_STRIPE_PRICE=price_...

# --- Novena — 9 preghiere in 9 giorni — 14,90 € ----------------------------
PRODUCT_NOVENA_CENTS=1490
# PRODUCT_NOVENA_CREDITS=9
# PRODUCT_NOVENA_CADENCE=daily
# PRODUCT_NOVENA_ENABLED=true
# PRODUCT_NOVENA_FEATURED=true
# PRODUCT_NOVENA_STRIPE_PRICE=price_...

# --- L'anno — 12 preghiere, una al mese — 19,90 € --------------------------
PRODUCT_YEAR_CENTS=1990
# PRODUCT_YEAR_CREDITS=12
# PRODUCT_YEAR_CADENCE=monthly
# PRODUCT_YEAR_ENABLED=true
# PRODUCT_YEAR_STRIPE_PRICE=price_...

# --- Trigesimo — 30 preghiere in 30 giorni — 39,90 € -----------------------
PRODUCT_TRIGESIMO_CENTS=3990
# PRODUCT_TRIGESIMO_CREDITS=30
# PRODUCT_TRIGESIMO_CADENCE=daily
# PRODUCT_TRIGESIMO_ENABLED=true
# PRODUCT_TRIGESIMO_STRIPE_PRICE=price_...

# --- Lucernario — candele a offerta libera ---------------------------------
LUCERNARIO_ENABLED=true
LUCERNARIO_SLOTS=50
LUCERNARIO_HOURS=24
LUCERNARIO_MIN_CENTS=100
LUCERNARIO_MAX_CENTS=100000
# Importi proposti come scorciatoia, in centesimi
LUCERNARIO_SUGGESTED=200,500,1000,2000

# --- Generazione: tempi, tentativi, allerte --------------------------------
# Minuti dichiarati all'utente. La generazione reale dura 20-40 s: si promette
# con margine, così la promessa regge se i fornitori rallentano.
GENERATION_ETA_MINUTES=2
# Quanti tentativi automatici prima di dichiarare fallita una preghiera.
# Ogni tentativo costa una chiamata OpenAI + una sintesi ElevenLabs: non alzarlo.
GENERATION_MAX_ATTEMPTS=3
# Dopo quanti minuti una preghiera ferma in 'generating' si considera piantata
# e torna prendibile (serve quando un processo muore a metà).
GENERATION_STALE_MINUTES=5
# Dove arrivano le allerte quando qualcosa si rompe.
ALERT_EMAIL=salvatore.campagnese@gmail.com

# ---------------------------------------------------------------------------
# Cron — consegna automatica di novena e trigesimo
#
# Su Vercel: la pianificazione è in `vercel.json` e il token viene iniettato
# automaticamente nell'header Authorization. Basta impostare CRON_SECRET.
# Su Supabase: snippet pg_cron in supabase/migrations/005_auto_delivery.sql.
#
# Senza CRON_SECRET l'endpoint risponde 503 e resta chiuso: meglio un cron che
# non parte di uno che chiunque può far girare a spese tue.
# ---------------------------------------------------------------------------
CRON_SECRET=
# Quante preghiere generare al massimo per giro (ognuna dura 20-40 s).
CRON_BATCH_SIZE=8
# Secondi oltre i quali il giro si ferma da solo, per non essere ucciso a metà.
CRON_TIME_BUDGET_SECONDS=240

# ---------------------------------------------------------------------------
# Email  (consegna della preghiera)
#
# Stripe NON può recapitare il contenuto digitale: le sue email sono ricevute
# di pagamento, senza corpo personalizzato né allegati. Da Stripe prendiamo
# solo l'indirizzo; l'invio lo fa Resend.
# Senza RESEND_API_KEY il servizio funziona lo stesso: niente email, la
# preghiera resta raggiungibile dal suo link privato.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_...
EMAIL_FROM=AlTuoDioCiPensoIO <preghiere@tuodominio.it>
EMAIL_REPLY_TO=

# ---------------------------------------------------------------------------
# Supabase  (Project Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role: SOLO lato server. Non esporre mai al client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Bucket dove finiscono gli mp3 delle preghiere (creato da supabase/schema.sql)
SUPABASE_AUDIO_BUCKET=prayers

# ---------------------------------------------------------------------------
# Stripe  (Developers -> API keys)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# I Price ID stanno nella sezione LISTINO qui sopra, uno per prodotto.
# Se li ometti, l'app crea i prezzi al volo dai *_CENTS: comodo per provare.

# ---------------------------------------------------------------------------
# OpenAI  (testo della preghiera)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# ElevenLabs  (voce)
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Voce di default: timbro maschile, grave, solenne.
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# Opzionali: voci alternative per tradizione religiosa (vedi src/lib/elevenlabs.ts)
ELEVENLABS_VOICE_ID_FEMALE=
ELEVENLABS_VOICE_ID_ARABIC=
