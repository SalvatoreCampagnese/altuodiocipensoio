# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================================================================
# LISTINO
# Tutto il catalogo si governa da qui: prezzo, numero di preghiere, ritmo di
# sblocco, attivazione. I valori commentati sono i default: togli il commento
# solo per ciò che vuoi cambiare.
#
#   *_CENTS    prezzo in centesimi (290 = 2,90 €)
#   *_CREDITS  quante preghiere include
#   *_CADENCE  instant | daily | monthly  (come si sbloccano i crediti)
#   *_ENABLED  true | false  (nasconde il prodotto dal sito)
#   *_FEATURED true | false  (lo evidenzia nella griglia)
#   *_NAME     nome mostrato
#   *_STRIPE_PRICE  Price ID di Stripe; se assente il prezzo è creato al volo
# ===========================================================================

# --- Una preghiera — 2,90 € (sempre attiva, non disattivabile) -------------
PRODUCT_SINGLE_CENTS=290
# PRODUCT_SINGLE_NAME=Una preghiera
# PRODUCT_SINGLE_STRIPE_PRICE=price_...

# ===========================================================================
# LA PREGHIERA DEL GIORNO — l'abbonamento, il prodotto di punta
#
# Il prezzo si ANNUNCIA al giorno e si ADDEBITA a periodo. Non è marketing:
# incassare 0,70 € ogni giorno lascerebbe a Stripe circa il 38 % dell'importo
# (0,25 € fissi + 1,5 %), contro il 6,5 % di un addebito settimanale. È quello
# che permette di tenere il prezzo a settanta centesimi invece di alzarlo.
#
#   SUB_DAILY_PER_DAY_CENTS × giorni del periodo = importo addebitato
#   70 × 7 = 490  →  "0,70 € al giorno, addebitati 4,90 € a settimana"
#
# Cambiando SUB_DAILY_INTERVAL l'importo si ricalcola da solo (day=1 giorno,
# week=7, month=30): SUB_DAILY_CENTS serve solo a forzarlo di proposito.
# ===========================================================================
SUB_DAILY_ENABLED=true
SUB_DAILY_PER_DAY_CENTS=70
# day | week | month — ogni quanto parte l'addebito
SUB_DAILY_INTERVAL=week
# Forza l'importo del periodo. Lascialo commentato: se diverge dal prezzo al
# giorno annunciato in pagina, l'utente trova sull'estratto conto una cifra
# che non gli torna, ed è la prima causa di contestazione.
# SUB_DAILY_CENTS=490
# SUB_DAILY_NAME=La Preghiera del Giorno
# Giorni di prova gratuita prima del primo addebito. 0 = nessuna.
SUB_DAILY_TRIAL_DAYS=0
# Ora di Roma in cui arriva l'email. Cambiarla qui NON basta: la pianificazione
# vera sta in supabase/migrations/009_pg_cron_daily_prayer.sql, e va allineata.
SUB_DAILY_HOUR=9
# Price ID di Stripe (deve essere un prezzo RICORRENTE). Se assente, il prezzo
# viene creato al volo dai valori qui sopra.
# SUB_DAILY_STRIPE_PRICE=price_...

# --- Come viene scritta la preghiera del giorno ----------------------------
# È una sola, uguale per tutti: una tradizione, una lingua, un tono. Il tema
# ruota su 31 giorni ed è nel codice (THEMES in src/lib/dailyPrayer.ts).
DAILY_PRAYER_RELIGION=cattolica
DAILY_PRAYER_LANGUAGE=it
DAILY_PRAYER_TONE=solenne

# --- Novena — 9 preghiere in 9 giorni — 14,90 € ----------------------------
PRODUCT_NOVENA_CENTS=1490
# PRODUCT_NOVENA_CREDITS=9
# PRODUCT_NOVENA_CADENCE=daily
# PRODUCT_NOVENA_ENABLED=true
# PRODUCT_NOVENA_FEATURED=true
# PRODUCT_NOVENA_STRIPE_PRICE=price_...

# --- L'anno — 12 preghiere, una al mese — 19,90 € --------------------------
PRODUCT_YEAR_CENTS=1990
# PRODUCT_YEAR_CREDITS=12
# PRODUCT_YEAR_CADENCE=monthly
# PRODUCT_YEAR_ENABLED=true
# PRODUCT_YEAR_STRIPE_PRICE=price_...

# --- Trigesimo — 30 preghiere in 30 giorni — 39,90 € -----------------------
PRODUCT_TRIGESIMO_CENTS=3990
# PRODUCT_TRIGESIMO_CREDITS=30
# PRODUCT_TRIGESIMO_CADENCE=daily
# PRODUCT_TRIGESIMO_ENABLED=true
# PRODUCT_TRIGESIMO_STRIPE_PRICE=price_...

# --- Lucernario — candele a offerta libera ---------------------------------
LUCERNARIO_ENABLED=true
LUCERNARIO_SLOTS=50
LUCERNARIO_HOURS=24
LUCERNARIO_MIN_CENTS=100
LUCERNARIO_MAX_CENTS=100000
# Importi proposti come scorciatoia, in centesimi
LUCERNARIO_SUGGESTED=200,500,1000,2000

# --- Generazione: tempi, tentativi, allerte --------------------------------
# Minuti dichiarati all'utente. La generazione reale dura 20-40 s: si promette
# con margine, così la promessa regge se i fornitori rallentano.
GENERATION_ETA_MINUTES=2
# Quanti tentativi automatici prima di dichiarare fallita una preghiera.
# Ogni tentativo costa una chiamata OpenAI + una sintesi ElevenLabs: non alzarlo.
GENERATION_MAX_ATTEMPTS=3
# Dopo quanti minuti una preghiera ferma in 'generating' si considera piantata
# e torna prendibile (serve quando un processo muore a metà).
GENERATION_STALE_MINUTES=5
# Dove arrivano le allerte quando qualcosa si rompe.
ALERT_EMAIL=salvatore.campagnese@gmail.com

# ---------------------------------------------------------------------------
# Cron — consegna automatica di novena e trigesimo
#
# La pianificazione sta su Supabase (pg_cron), non su Vercel: il piano Hobby
# consente un solo cron al giorno. Vedi supabase/migrations/006_pg_cron_delivery.sql.
#
# Questo valore va in DUE posti: qui, e nel Vault di Supabase come segreto
# chiamato `cron_secret` — è da lì che il job legge il bearer token:
#   select vault.create_secret('...', 'cron_secret');
#
# Senza CRON_SECRET l'endpoint risponde 503 e resta chiuso: meglio un cron che
# non parte di uno che chiunque può far girare a spese tue.
# ---------------------------------------------------------------------------
CRON_SECRET=
# Quante preghiere generare al massimo per giro (ognuna dura 20-40 s).
CRON_BATCH_SIZE=8
# Secondi oltre i quali il giro si ferma da solo, per non essere ucciso a metà.
CRON_TIME_BUDGET_SECONDS=240
# Quante email della preghiera del giorno per ogni giro delle 9. Il massimo è
# 100: è il limite di un invio in lotto di Resend. Con più abbonati servono
# più passaggi, ed è per questo che il job delle 9 gira ogni 20 minuti.
CRON_MAIL_BATCH=100

# ---------------------------------------------------------------------------
# Email  (consegna della preghiera)
#
# Stripe NON può recapitare il contenuto digitale: le sue email sono ricevute
# di pagamento, senza corpo personalizzato né allegati. Da Stripe prendiamo
# solo l'indirizzo; l'invio lo fa Resend.
# Senza RESEND_API_KEY il servizio funziona lo stesso: niente email, la
# preghiera resta raggiungibile dal suo link privato.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_...
EMAIL_FROM=AlTuoDioCiPensoIO <preghiere@tuodominio.it>
EMAIL_REPLY_TO=

# ---------------------------------------------------------------------------
# Supabase  (Project Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role: SOLO lato server. Non esporre mai al client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Bucket dove finiscono gli mp3 delle preghiere (creato da supabase/schema.sql)
SUPABASE_AUDIO_BUCKET=prayers

# ---------------------------------------------------------------------------
# Stripe  (Developers -> API keys)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# I Price ID stanno nella sezione LISTINO qui sopra, uno per prodotto.
# Se li ometti, l'app crea i prezzi al volo dai *_CENTS: comodo per provare.

# ---------------------------------------------------------------------------
# OpenAI  (testo della preghiera)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# ElevenLabs  (voce)
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Voce di default: timbro maschile, grave, solenne.
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# Opzionali: voci alternative per tradizione religiosa (vedi src/lib/elevenlabs.ts)
ELEVENLABS_VOICE_ID_FEMALE=
ELEVENLABS_VOICE_ID_ARABIC=
# Voce per l'ebraico (Ebraismo). Come sopra: una voce madrelingua cambia molto.
ELEVENLABS_VOICE_ID_HEBREW=
# Modello per ebraico, urdu, persiano, punjabi e vietnamita: multilingual_v2
# non le conosce. Attenzione, v3 non supporta `speed` e `similarity_boost`
# e si ferma a 5.000 caratteri. Vedi pickModelId() in src/lib/elevenlabs.ts.
ELEVENLABS_MODEL_ID_V3=eleven_v3

# ---------------------------------------------------------------------------
# PUBBLICITÀ — Google AdSense
#
# ATTENZIONE: a differenza di un link di affiliazione, AdSense carica uno
# script di Google che imposta COOKIE DI PROFILAZIONE. Da quando è acceso, il
# sito non può più dichiarare di non averne — /cookie, /privacy e /termini
# sono già stati riscritti di conseguenza.
#
# Il consenso per il traffico SEE/UK NON si raccoglie dal codice: Google
# pretende una CMP certificata TCF e ne fornisce una gratuita. Si accende dal
# cruscotto AdSense in «Privacy e messaggi → messaggio GDPR». Senza, Google
# limita o smette di servire annunci in Europa.
# ---------------------------------------------------------------------------
ADS_ENABLED=true
ADSENSE_CLIENT=ca-pub-5107049257138780

# ANNUNCI AUTOMATICI ACCESI: le posizioni le sceglie Google, ovunque nel sito,
# preghiere acquistate e checkout compresi. È una scelta deliberata, ed è
# dichiarata in /termini, /cookie e /privacy — se la cambi, cambia anche quei
# testi, perché sono loro a dire all'utente cosa aspettarsi.
#
# Questi due ID servono solo alla strada opposta: unità piazzate a mano.
# LASCIALI VUOTI finché gli annunci automatici sono accesi, o avrai entrambe
# le cose sulla stessa pagina, cioè il doppio degli annunci. Servono se un
# giorno spegni gli automatici per riprendere il controllo delle posizioni.
ADSENSE_SLOT_FOOTER=
ADSENSE_SLOT_ARTICOLO=

# Annunci finti invece che veri. Il default segue NODE_ENV (finti fuori
# produzione): le impression da localhost o dalle anteprime sono traffico non
# valido, ed è il motivo più comune di sospensione di un account AdSense.
# ADSENSE_TEST_MODE=true

# --- Avviso a chi blocca la pubblicità -------------------------------------
# Chiede una volta, gentilmente, e poi tace. NON è un muro: chi chiude entra e
# legge lo stesso, ed è deliberato — su un sito dove si arriva con un lutto
# addosso una porta chiusa fa tornare in SERP, non convertire.
# Si spegne da solo se ADS_ENABLED=false: senza annunci non c'è niente da
# bloccare e l'avviso sarebbe un'accusa a vuoto.
ADBLOCK_NOTICE_ENABLED=true
# Per quanti giorni tacere dopo che l'utente l'ha chiuso.
ADBLOCK_NOTICE_DISMISS_DAYS=30
# Secondi prima di misurare: sotto i 3 si accusa di blocco chi ha solo una
# connessione lenta, perché lo script di Google non ha ancora finito.
ADBLOCK_NOTICE_DELAY_SECONDS=3
# Per provarlo senza installare un blocco: apri una pagina con ?adblock=test
